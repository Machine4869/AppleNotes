<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="0dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="备忘录"
                android:textColor="@color/ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/syncDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_sync_dot" />

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="已同步 · 0 条"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_action_search"
                android:tint="@color/ink_secondary" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/searchClear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清除"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </LinearLayout>

        <Spinner
            android:id="@+id/accountSpinner"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <de.niendo.ImapNotes3.ListSwipeRefreshLayout
            android:id="@+id/swipeContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ListView
                    android:id="@+id/notesList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="100dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:alpha="0.9"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_empty_note" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="还没有笔记"
                        android:textColor="@color/ink"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="点右下角 + 新建一篇"
                        android:textColor="@color/ink_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </de.niendo.ImapNotes3.ListSwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="20dp"
        android:contentDescription="@string/new_note"
        android:src="@drawable/ic_pencil"
        app:backgroundTint="@color/fab_yellow"
        app:elevation="6dp"
        app:fabSize="normal"
        app:tint="@color/ink" />
</FrameLayout>
